{
  "name": "vlan",
  "version": "1.0.0",
  "sdk": "^0.1",
  "entry": "index.js",
  "catalogs": { "fr": "i18n/fr.json", "en": "i18n/en.json" },
  "extensions": [
    {
      "point": "view",
      "id": "groups",
      "element": "vlan-groups",
      "nav": "nav.groups",
      "permission": "core.vlan_group.read"
    },
    {
      "point": "view",
      "id": "vlans",
      "element": "vlan-vlans",
      "nav": "nav.vlans",
      "permission": "core.vlan.read"
    },
    {
      "point": "tab",
      "id": "network",
      "element": "vlan-network",
      "object_types": ["prefix"],
      "label": "tab.label",
      "permission": "core.vlan.read"
    },
    {
      "point": "column",
      "id": "vlan",
      "element": "vlan-column",
      "object_types": ["prefix"],
      "label": "column.label",
      "permission": "core.vlan.read"
    },
    {
      "point": "action",
      "id": "create-vlan",
      "element": "vlan-create",
      "object_types": ["prefix"],
      "label": "action.label",
      "permission": "core.vlan.edit"
    }
  ]
}
